{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "weihnachtswunschliste",
  "main": "./Worker/src.js",
  "compatibility_date": "2026-11-18",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": ["/reservations*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "wunschliste",
      "database_id": "fac769d0-e817-4655-8831-2e0d2a188632"
    }
  ]
}
